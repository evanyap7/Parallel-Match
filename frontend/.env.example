# Public browser configuration. No secrets belong in VITE_ variables.
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_AGENTS_BASE_URL=/agents
# Development only: Vite forwards /agents to this service, avoiding CORS issues.
# VITE_AGENTS_PROXY_TARGET=http://127.0.0.1:8001
# Production: provide /agents through the hosting proxy or an HTTPS agent URL with CORS enabled.
