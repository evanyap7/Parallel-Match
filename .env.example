# Copy to .env (git-ignored) and fill in. Never commit real values.
# Azure Container Apps deployment (deploy/deploy.sh)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-the-home-dugout
AZURE_LOCATION=japaneast         # Azure for Students: an allowed region
AZURE_CONTAINER_REGISTRY=          # registry name, e.g. pmdugoutacr
# MIN_REPLICAS=1                   # keep 1 warm while judges are looking

# Azure AI Foundry (agents). PM_AGENT_BACKEND=template works with none of
# these set; foundry requires them plus az login or a managed identity.
PM_AGENT_BACKEND=template
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_FOUNDRY_MODEL=gpt-4o-mini
# Resource ID of the Foundry (AI Services) resource, so deploy.sh can grant
# pm-agents' managed identity "Azure AI User" on it:
# /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
AZURE_AI_FOUNDRY_RESOURCE_ID=
# PM_AGENT_TIMEOUT_S=8             # per model call; template on timeout
# PM_AGENT_COOLDOWN_S=60           # skip the model this long after a failure
# PM_CORS_ORIGINS=*                # agents API; comma-separated origins

# Local service locations (defaults shown)
# PM_MCP_HOST=0.0.0.0
# PM_MCP_PORT=8080
